{
  "id": "io.github.cappedcat1710.Reeds",
  "runtime": "org.projectluma.Platform",
  "runtime-version": "44",
  "sdk": "org.projectluma.Sdk",
  "command": "run-app",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "application",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 run-app /app/bin/run-app",
        "install -Dm644 src/main.py /app/share/io.github.cappedcat1710.Reeds/main.py",
        "install -Dm644 src/reeds_feeds.py /app/share/io.github.cappedcat1710.Reeds/reeds_feeds.py",
        "install -Dm644 src/reeds_store.py /app/share/io.github.cappedcat1710.Reeds/reeds_store.py",
        "install -Dm644 src/reeds.css /app/share/io.github.cappedcat1710.Reeds/reeds.css",
        "install -Dm644 data/io.github.cappedcat1710.Reeds.desktop /app/share/applications/io.github.cappedcat1710.Reeds.desktop",
        "install -Dm644 data/io.github.cappedcat1710.Reeds.metainfo.xml /app/share/metainfo/io.github.cappedcat1710.Reeds.metainfo.xml",
        "install -Dm644 data/io.github.cappedcat1710.Reeds.svg /app/share/icons/hicolor/scalable/apps/io.github.cappedcat1710.Reeds.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ]
    }
  ]
}
